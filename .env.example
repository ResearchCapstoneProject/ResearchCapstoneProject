# ---------------------------------------------------------------
# Botswana National Museum — environment configuration
# Copy to .env and fill in the two secrets marked CHANGE ME.
#   cp .env.example .env
#   openssl rand -hex 32        # -> SESSION_SECRET
# ---------------------------------------------------------------

# --- Which compose files apply (read by docker compose itself) ---
# Development machines: leave this commented out, and `docker compose up` runs
# the plain stack from docker-compose.yml -- uvicorn with --reload, 8000 on
# every interface, no Caddy.
#
# On the SERVER, uncomment it. It adds compose.prod.yaml: Caddy in front on
# port 80, no --reload, and 3307/8000 bound to loopback. Every plain
# `docker compose ...` command then picks it up with no -f flags.
#COMPOSE_FILE=docker-compose.yml:compose.prod.yaml

# --- MySQL (consumed by docker compose's db service) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=bnm
MYSQL_USER=bnm
MYSQL_PASSWORD=change-me-bnm

# --- Backend ---
# Inside docker compose the host is the service name `db`.
# For a locally installed MySQL use 127.0.0.1:3307 (the port compose publishes).
DATABASE_URL=mysql+pymysql://bnm:change-me-bnm@db:3306/bnm?charset=utf8mb4

# CHANGE ME — openssl rand -hex 32
SESSION_SECRET=

# 0 for plain http://localhost, 1 once the site is served over HTTPS.
# 1 on anything that serves HTTPS -- the session cookie then never leaves
# over an unencrypted connection. Keep it 0 for local development, which has
# no certificate.
COOKIE_SECURE=0

# Which Caddy configuration the server mounts, and the address its
# certificate is for. Leave both empty for local development (Caddy only runs
# on the server, through compose.prod.yaml).
#   CADDY_CONFIG=Caddyfile.https
#   SITE_ADDRESS=138.2.190.25

# The origin baked into printed QR codes. On pilot day set this to the
# museum's LAN IP or real domain and every new label follows automatically.
PUBLIC_BASE_URL=http://localhost:8000

UPLOAD_DIR=/data/uploads
# --- e-mail -----------------------------------------------------------------
# off    nothing is sent, and the ticket page does not promise a confirmation
# outbox messages are written to MAIL_OUTBOX_DIR as files -- for development
#        and for looking at the wording without a mail account
# smtp   handed to SMTP_HOST
MAIL_MODE=off
# Must NOT be inside UPLOAD_DIR: that directory is served at /uploads, so
# messages placed there would be downloadable by anyone.
MAIL_OUTBOX_DIR=/data/outbox
# The project's own mailbox for now; to be replaced by an address on the
# museum's own domain (national-museum.gov.bw) when there is one.
MAIL_FROM=Botswana National Museum <botswana-national-museum@gmx.net>
# Where a visitor's reply goes; leave empty to use MAIL_FROM.
MAIL_REPLY_TO=
# GMX refuses SMTP logins until POP3/IMAP is switched on once in the
# mailbox's own settings. The password belongs in the server's .env only.
SMTP_HOST=mail.gmx.net
SMTP_PORT=587
SMTP_USER=botswana-national-museum@gmx.net
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_TIMEOUT=10

SEED_ON_START=1

# `like` reproduces the prototype's substring search exactly.
# `fulltext` uses the ft_object index (see doc/ARCHITECTURE.md before switching).
SEARCH_MODE=like

# Only needed for the standalone frontend dev server; inert inside docker.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# First-run admin account, created by the seeder when no staff user exists.
# CHANGE ME before the first `docker compose up`.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
