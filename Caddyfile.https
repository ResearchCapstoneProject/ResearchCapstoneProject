# Caddy in front of the museum site, with HTTPS.
#
# Switched on from the server's .env -- the file itself needs no editing:
#
#   CADDY_CONFIG=Caddyfile.https
#   SITE_ADDRESS=138.2.190.25        # or the museum's domain once there is one
#   COOKIE_SECURE=1
#
# Why this matters: a booking sends the visitor's name, e-mail address and
# phone number, and the staff sign-in sends a password. Over plain HTTP both
# travel readable across every network in between.
#
# Let's Encrypt does issue certificates for a bare IP address, but only
# short-lived ones -- `profile shortlived` asks for exactly those. Without it
# Caddy falls back to a self-signed certificate and browsers refuse it. Caddy
# treats the profile as experimental, so check that the site actually serves
# before relying on it in front of the museum.
#
# With a domain name instead of an IP, delete the whole `tls` block: Caddy
# then obtains an ordinary certificate by itself.

{$SITE_ADDRESS} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	encode zstd gzip

	# `api` is the Compose service name, reached over the project's internal
	# network. 8000 is the port inside the container, not a published one.
	reverse_proxy api:8000

	log {
		output stdout
		format console
	}
}

# Anything that still arrives on plain HTTP goes to HTTPS. A QR code printed
# with an http:// address therefore keeps working.
:80 {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
